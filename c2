#include <stdio.h>
#include <stdlib.h>

int main() {
    FILE *file;
    char content[] = "This is the content of File.txt.\n";

    file = fopen("File.txt", "w");
    if (file == NULL) {
        printf("Error opening file!\n");
        return 1;
    }

    fprintf(file, "%s", content);
    fclose(file);

    printf("File.txt has been created and content has been written.\n");

    return 0;
}
